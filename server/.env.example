# Copy to ".env" and fill in. Never commit the real ".env".

# Required for real use. Without it, a local JSON file is used (development only).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=glint

# Required in production. Any long random string (32+ characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional. Your client's address, so only your site can call the API.
CLIENT_ORIGIN=

PORT=3000
